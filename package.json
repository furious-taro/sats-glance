{
  "name": "sats-glance",
  "version": "0.1.0",
  "private": true,
  "description": "Hands-free, watch-only Bitcoin payment and fee watcher for Even Realities G2 smart glasses.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mocks": "vite build --config scripts/vite.mocks.config.ts --logLevel warn && node build-scripts/render-mocks.mjs .",
    "pack:ehpk":"evenhub pack app.json dist -o sats-glance.ehpk --sdk-ver 0.0.16",
    "sim": "evenhub-simulator http://localhost:5173",
    "sim:auto": "evenhub-simulator http://localhost:5173 --automation-port 9898"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@evenrealities/pretext": "0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.17"
  }
}
